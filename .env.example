# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=eventflow
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=            # required: set a strong password

# ── JWT ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=                   # required: 64-char hex string
JWT_EXPIRATION_MS=86400000    # 24 hours in ms

# ── Mail ────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=                # required: your sending email address
MAIL_PASSWORD=                # required: app password (not your login password)

# ── App ─────────────────────────────────────────────────────
BASE_URL=http://localhost:8080
APP_PORT=8080